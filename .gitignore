# the second line covers every topic folder, so a new entry in the config needs no line here
site/group/
site/*/index.html
# round 56: the comparisons, the per-language sitemaps and the pages' shared look (the part and year pages are top-level
# folders, covered by the line above)
site/compare/
site/sitemap-*.xml
site/pages.css
# round 58: every page's Markdown version (index.md next to its index.html), the downloads and the guide for automated
# readers (pipeline/seo_pages.mjs)
site/*/index.md
site/downloads/
site/llms.txt
site/llms-full.txt
node_modules/

# raw downloads: small open-data API responses are kept; large files and third-party documents (reports, press
# pages, the Kiel workbook) are listed in research/2026-10/raw/MANIFEST.json with their address and checksum instead
research/2026-10/raw/**/*.xlsx
research/2026-10/raw/**/*.xls
research/2026-10/raw/**/*.pdf
research/2026-10/raw/**/*.html
research/2026-10/raw/**/*.htm
research/2026-10/raw/**/*.csv.gz

